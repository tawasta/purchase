<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_purchaseorder_document_orderlines"
        inherit_id="purchase_report_orderlines.report_purchaseorder_document_orderlines"
    >
        <xpath expr="//td[@id='product']/span[@t-field='line.name']" position="after">
            <t t-if="o.print_manuf_code and line.product_id.manufacturer_pref">
                <br />
                <span>Manuf. code: </span>
                <span t-field="line.product_id.manufacturer_pref" />
            </t>
        </xpath>
    </template>

</odoo>
