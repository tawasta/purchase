<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_purchasequotation_document"
        inherit_id="purchase.report_purchasequotation_document"
    >
        <xpath
            expr="//td[@id='product']/span[@t-field='order_line.name']"
            position="after"
        >
            <t t-if="o.print_manuf_code and order_line.product_id.manufacturer_pref">
                <br />
                <span>Manuf. code: </span>
                <span t-field="order_line.product_id.manufacturer_pref" />
            </t>
        </xpath>
    </template>

</odoo>
