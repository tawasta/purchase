<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="product_template_form_view" model="ir.ui.view">
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//group[@name='purchase']" position="after">
        <group name="purchase_attached_products" groups="purchase.group_purchase_user">
          <group string="Attached Purchase Products">
            <field
              name="purchase_attached_product_ids"
              widget="many2many_tags"
              options="{'color_field': 'color'}"
              domain="[('product_tmpl_id', '!=', id), ('purchase_ok', '=', True), ('company_id', 'in', [company_id, False])]"
            />
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
