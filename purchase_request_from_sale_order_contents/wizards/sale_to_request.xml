<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_to_request_view_form" model="ir.ui.view">
        <field name="name">sale.to.request.view.form</field>
        <field name="model">purchase_request_from_sale_contents.sale_to_request</field>
        <field name="arch" type="xml">
            <form string="Add SO to Purchase Request">
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group name="group_sale" invisible="state != 'sale_selection'">
                        <field
                            name="sale_id"
                            options="{ 'no_create': True }"
                            required="state == 'sale_selection'"
                        />
                    </group>

                    <div invisible="state != 'qty_calculation'">
                        <separator string="Options" />
                        <p invisible="state != 'qty_calculation'">
                            Please select how the components below should be added to the purchase request.
                        </p>
                        <group>
                            <field
                                name="multiplier"
                                required="state == 'qty_calculation'"
                            />
                            <field name="combine_with_existing" />
                        </group>
                        <p>Lines in red indicate an archived product.</p>
                    </div>

                    <field
                        name="product_line_ids"
                        options="{ 'no_create': True }"
                        nolabel="1"
                        invisible="state != 'qty_calculation'"
                        required="state == 'qty_calculation'"
                    >
                        <tree
                            editable="bottom"
                            decoration-danger="product_active==False"
                        >
                            <field name="product_id" />
                            <field name="qty" />
                            <field name="uom_id" />
                            <field name="product_active" column_invisible="True" />
                        </tree>
                    </field>
                    <footer>
                        <button
                            string="Calculate Quantities"
                            name="calculate_quantities"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'sale_selection'"
                        />
                        <button
                            string="Add to Purchase Request"
                            name="add_request_lines"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'qty_calculation'"
                        />
                        <button string="Cancel" class="btn-default" special="cancel" />
                    </footer>

                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_to_request_action" model="ir.actions.act_window">
        <field name="name">Sale Order to Purchase Request</field>
        <field name="type">ir.actions.act_window</field>
        <field
            name="res_model"
        >purchase_request_from_sale_contents.sale_to_request</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sale_to_request_view_form" />
        <field name="binding_model_id" ref="purchase_request.model_purchase_request" />
    </record>
</odoo>
