<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_purchaseorder_document"
        inherit_id="purchase.report_purchaseorder_document"
    >
        <t t-if="o.dest_address_id" position="attributes">
            <attribute
                name="t-if"
            >not o.original_sale_id and o.dest_address_id</attribute>
	    </t>

        <xpath expr="//div[@t-if='o.dest_address_id']/../.." position="after">
            <t t-elif="o.original_sale_id">
                <t t-set="information_block">
                    <strong>Shipping address:</strong>
                    <div t-if="o.original_sale_id">
                        <div
                            t-field="o.original_sale_id.partner_shipping_id"
                            t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'
                        />
                    </div>
                </t>
	        </t>
	    </xpath>
	</template>

    <template
        id="report_purchasequotation_document"
        inherit_id="purchase.report_purchasequotation_document"
    >
        <t t-if="o.dest_address_id" position="attributes">
            <attribute
                name="t-if"
            >not o.original_sale_id and o.dest_address_id</attribute>
	    </t>

        <xpath expr="//div[@t-field='o.dest_address_id']/../.." position="after">
            <t t-elif="o.original_sale_id">
                <t t-set="information_block">
                    <strong>Shipping address:</strong>
                    <div t-if="o.original_sale_id">
                        <div
                            t-field="o.original_sale_id.partner_shipping_id"
                            t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'
                        />
                    </div>
                </t>
	        </t>
	    </xpath>
	</template>
</odoo>
