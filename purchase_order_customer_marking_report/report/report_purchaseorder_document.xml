<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <template
    id="report_purchaseorder_document_customer_marking"
    inherit_id="purchase.report_purchaseorder_document"
  >
    <xpath
      expr="//div[@id='informations']/div[div[@t-field='o.user_id']]"
      position="after"
    >
      <div
        t-if="o.customer_marking"
        class="col-auto col-3 mw-100 mb-2"
        name="informations_customer_marking"
      >
        <strong>Customer Marking:</strong>
        <br />
        <span class="m-0" t-field="o.customer_marking" />
      </div>
    </xpath>
  </template>
</odoo>
