<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <template
    id="report_purchasequotation_document"
    inherit_id="purchase.report_purchasequotation_document"
  >
    <xpath expr="//t[@t-set='o']" position="before">
      <t t-set="report_title">REQUEST FOR QUOTATION</t>
    </xpath>
    <xpath expr="//t[@t-set='layout_document_title']//span[1]" position="attributes">
      <attribute name="class">d-none</attribute>
    </xpath>
  </template>
  <template
    id="report_purchaseorder_document"
    inherit_id="purchase.report_purchaseorder_document"
  >
    <xpath expr="//t[@t-set='o']" position="before">
      <t t-set="report_title">PURCHASE ORDER</t>
    </xpath>
    <xpath
      expr='//t[@t-if="o.state in [&apos;draft&apos;, &apos;sent&apos;, &apos;to approve&apos;]"]'
      position="attributes"
    >
      <attribute name="class">d-none</attribute>
    </xpath>
    <xpath expr='//t[@t-if="o.state == &apos;purchase&apos;"]' position="attributes">
      <attribute name="class">d-none</attribute>
    </xpath>
    <xpath expr='//t[@t-if="o.state == &apos;cancel&apos;"]' position="attributes">
      <attribute name="class">d-none</attribute>
    </xpath>
  </template>
</odoo>
