<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_tree_reminder_confirmed" model="ir.ui.view">
        <field name="name">purchase.order.tree.reminder.confirmed</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree" />
        <field name="arch" type="xml">
            <field name="date_planned" position="after">
                <field name="mail_reminder_confirmed" optional="show" />
            </field>
        </field>
    </record>
    <record id="purchase_order_kpis_tree_reminder_confirmed" model="ir.ui.view">
        <field name="name">purchase.order.tree.reminder.confirmed</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree" />
        <field name="arch" type="xml">
            <field name="date_planned" position="after">
                <field name="mail_reminder_confirmed" optional="show" />
            </field>
        </field>
    </record>
    <record id="purchase_order_view_tree_reminder_confirmed" model="ir.ui.view">
        <field name="name">purchase.order.view.tree.reminder.confirmed</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree" />
        <field name="arch" type="xml">
            <field name="date_planned" position="after">
                <field name="mail_reminder_confirmed" optional="show" />
            </field>
        </field>
    </record>
</odoo>
