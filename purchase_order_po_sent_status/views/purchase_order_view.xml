<?xml version="1.0" ?>
<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.view.form.print.po</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header//button[@name='print_quotation'][1]" position="after">
                <button
                    name="print_purchase_order"
                    string="Print PO"
                    type="object"
                    class="oe_highlight"
                    groups="base.group_user"
                    invisible="state != 'sent'"
                />
            </xpath>

            <xpath expr="//header//button[@name='action_rfq_send'][2]" position="after">
                <button
                    name="print_purchase_order"
                    string="Print PO"
                    type="object"
                    groups="base.group_user"
                    invisible="state != 'po_sent'"
                />
            </xpath>

            <xpath expr="//header//field[@name='state']" position="attributes">
                <attribute
                    name="statusbar_visible"
                >draft,sent,po_sent,purchase</attribute>
            </xpath>

            <xpath
                expr="//header//button[@name='button_confirm'][1]"
                position="attributes"
            >
                <attribute name="invisible">state != 'po_sent'</attribute>
            </xpath>

            <xpath expr="//header//button[@name='button_cancel']" position="attributes">
                <attribute
                    name="invisible"
                >state not in ('draft', 'to approve', 'sent', 'po_sent', 'purchase')</attribute>
            </xpath>

            <xpath expr="//button[@name='action_view_invoice']" position="attributes">
                <attribute
                    name="invisible"
                >invoice_count == 0 or state in ('draft', 'sent', 'po_sent', 'to approve')</attribute>
            </xpath>

            <xpath
                expr="//div[@class='oe_title']//span[@class='o_form_label'][1]"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >state not in ('draft', 'po_sent', 'sent')</attribute>
            </xpath>

            <xpath
                expr="//div[@class='oe_title']//span[@class='o_form_label'][2]"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >state in ('draft', 'sent', 'po_sent')</attribute>
            </xpath>

            <xpath
                expr="//div[@name='date_planned_div']//field[@name='date_planned']"
                position="attributes"
            >
                <attribute
                    name="readonly"
                >state not in ('draft', 'sent', 'po_sent', 'to approve', 'purchase')</attribute>
            </xpath>

            <xpath
                expr="//group[@name='invoice_info']//field[@name='invoice_status']"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >state in ('draft', 'sent', 'po_sent', 'to approve', 'cancel')</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_filter" model="ir.ui.view">
        <field name="name">request.quotation.select.po.sent</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter" />
        <field name="arch" type="xml">
            <filter name="draft" position="attributes">
                <attribute
                    name="domain"
                >[('state', 'in', ('draft', 'sent', 'po_sent', 'to approve'))]</attribute>
            </filter>

            <filter name="waiting_rfqs" position="attributes">
                <attribute
                    name="domain"
                >[('state', 'in', ('sent', 'po_sent')), ('date_order', '&gt;=', datetime.datetime.now())]</attribute>
            </filter>

            <filter name="late_rfqs" position="attributes">
                <attribute
                    name="domain"
                >[('state', 'in', ['draft', 'sent', 'po_sent', 'to approve']),('date_order', '&lt;', datetime.datetime.now())]</attribute>
            </filter>
        </field>
    </record>

    <record id="purchase_order_tree" model="ir.ui.view">
        <field name="name">purchase.order.tree.po.sent</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree" />
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute
                    name="decoration-info"
                >state in ('draft','sent','po_sent')</attribute>
            </field>
        </field>
    </record>

    <record id="purchase_order_kpis_tree" model="ir.ui.view">
        <field name="name">purchase.order.tree.kpis.po.sent</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree" />
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute
                    name="decoration-info"
                >state in ['draft', 'sent', 'po_sent']</attribute>
            </tree>

            <xpath expr="//tree//field[@name='state']" position="attributes">
                <attribute
                    name="decoration-info"
                >state == 'draft' or state == 'sent' or state == 'po_sent'</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_tree" model="ir.ui.view">
        <field name="name">purchase.order.view.tree.po.sent</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//tree//field[@name='name']" position="attributes">
                <attribute
                    name="decoration-info"
                >state in ('draft','sent','po_sent')</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_activity" model="ir.ui.view">
        <field name="name">purchase.order.activity.po.sent</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_activity" />
        <field name="arch" type="xml">
            <xpath expr="//activity//field[@name='state']" position="attributes">
                <attribute
                    name="decoration-info"
                >state == 'draft' or state == 'sent' or state == 'po_sent'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
