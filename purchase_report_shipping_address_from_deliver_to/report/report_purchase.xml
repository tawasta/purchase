<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_purchaseorder_document"
        inherit_id="purchase_stock.report_purchaseorder_document"
    >
        <xpath
            expr="//span[@t-field='o.picking_type_id.warehouse_id.name']/.."
            position="attributes"
        >
            <attribute
                name="t-if"
            >o.picking_type_id and o.picking_type_id.warehouse_id and not o.picking_type_id.dest_address_id</attribute>
        </xpath>

        <xpath
            expr="//span[@t-field='o.picking_type_id.warehouse_id.name']/.."
            position="after"
        >
            <div
                t-if="o.picking_type_id and o.picking_type_id.warehouse_id and o.picking_type_id.dest_address_id"
            >
                <span t-field="o.picking_type_id.dest_address_id.name" />
                <div
                    t-field="o.picking_type_id.dest_address_id"
                    t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"
                />
            </div>
        </xpath>
    </template>

    <template
        id="report_purchasequotation_document"
        inherit_id="purchase_stock.report_purchasequotation_document"
    >
        <xpath
            expr="//span[@t-field='o.picking_type_id.warehouse_id.name']/.."
            position="attributes"
        >
            <attribute
                name="t-if"
            >o.picking_type_id and o.picking_type_id.warehouse_id and not o.picking_type_id.dest_address_id</attribute>
        </xpath>

        <xpath
            expr="//span[@t-field='o.picking_type_id.warehouse_id.name']/.."
            position="after"
        >
            <div
                t-if="o.picking_type_id and o.picking_type_id.warehouse_id and o.picking_type_id.dest_address_id"
            >
                <span t-field="o.picking_type_id.dest_address_id.name" />
                <div
                    t-field="o.picking_type_id.dest_address_id"
                    t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"
                />
            </div>
        </xpath>
    </template>
</odoo>
