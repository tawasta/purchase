<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_purchaseorder_document_orderlines_revision_code"
        inherit_id="purchase_report_orderlines.report_purchaseorder_document_orderlines"
    >
        <xpath expr="//th[@id='th_description']" position="before">
            <th name="th_default_code" class="text-start"><strong>Product</strong></th>
        </xpath>
        <xpath expr="//td[@name='td_description']" position="before">
            <td name="td_default_code" class="text-start">
                <t t-if="line.product_id.default_code">
                    <t
                        t-set="parts"
                        t-value="line.product_id.default_code.split(' ')"
                    />
                    <t t-if="len(parts) > 1">
                        <span t-esc="parts[0]" />
                    </t>
                    <t t-else="">
                        <span t-esc="line.product_id.default_code" />
                    </t>
                </t>
            </td>
        </xpath>


        <xpath expr="//th[@id='th_description']" position="before">
            <th name="th_revision_code" class="text-start"><strong
                >Revision</strong></th>
        </xpath>
        <xpath expr="//td[@name='td_description']" position="before">
            <td name="td_revision_code" class="text-start">
                <span t-field="line.product_id.revision_code" />
            </td>
        </xpath>

        <!-- Removing default code from description field -->
        <xpath
            expr="//td[@name='td_description']//span[@t-field='line.name']"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath
            expr="//td[@name='td_description']//span[@t-field='line.name']"
            position="before"
        >
            <t
                t-set="code_prefix"
                t-value="'[%s] ' % line.product_id.default_code if line.product_id.default_code else ''"
            />
            <t
                t-set="clean_name"
                t-value="line.name[len(code_prefix):] if code_prefix and line.name.startswith(code_prefix) else line.name"
            />
            <span t-esc="clean_name" />
        </xpath>
    </template>
</odoo>
