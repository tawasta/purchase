<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_purchasequotation_document_revision_code"
        inherit_id="purchase.report_purchasequotation_document"
    >
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_product_name" class="text-start"><strong>Product</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="before">
            <td name="td_default_code" class="text-start">
                <t t-if="order_line.product_id.default_code">
                    <t
                        t-set="parts"
                        t-value="order_line.product_id.default_code.split(' ')"
                    />
                    <t t-if="len(parts) > 1">
                        <span t-esc="parts[0]" />
                    </t>
                    <t t-else="">
                        <span t-esc="order_line.product_id.default_code" />
                    </t>
                </t>
            </td>
        </xpath>

        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_revision_code" class="text-start"><strong
                >Revision</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="before">
            <td name="td_revision_code" class="text-start">
                <span t-field="order_line.product_id.revision_code" />
            </td>
        </xpath>

        <!-- Removing default code from description field -->
        <xpath
            expr="//td[@id='product']//span[@t-field='order_line.name']"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath
            expr="//td[@id='product']//span[@t-field='order_line.name']"
            position="before"
        >
            <t
                t-set="code_prefix"
                t-value="'[%s] ' % order_line.product_id.default_code if order_line.product_id.default_code else ''"
            />
            <t
                t-set="clean_name"
                t-value="order_line.name[len(code_prefix):] if code_prefix and order_line.name.startswith(code_prefix) else order_line.name"
            />
            <span t-esc="clean_name" />
        </xpath>
    </template>
</odoo>
