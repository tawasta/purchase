<?xml version="1.0" ?>
<odoo>
  <record id="view_order_form_inherit_project_purchase" model="ir.ui.view">
    <field name="name">purchase.order.form.set.project.for.line</field>
    <field name="model">purchase.order</field>
    <field
      name="inherit_id"
      ref="project_purchase.view_order_form_inherit_project_purchase"
    />
    <field name="arch" type="xml">
      <field name="project_id" position="attributes">
        <attribute name="invisible">True</attribute>
      </field>

      <field name="partner_ref" position="after">
        <field
          name="project_id"
          readonly="state not in ('draft', 'sent')"
          groups="project.group_project_user"
        />
        <label string=" " for="set_line_analytic" />
        <button
          name="set_line_analytic"
          type="object"
          string="Set project for all order lines"
          class="oe_edit_only oe_right oe_link"
          invisible="state not in ['draft', 'sent']"
        />
      </field>
    </field>
  </record>
</odoo>
